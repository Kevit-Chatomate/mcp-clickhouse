# ClickHouse connection (use the dedicated read-only mcp_support user, see TECH_SUPPORT.md)
CLICKHOUSE_HOST=your-clickhouse-host
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=mcp_support
CLICKHOUSE_PASSWORD=change-me
CLICKHOUSE_SECURE=true
CLICKHOUSE_VERIFY=true

# MCP server over HTTP
CLICKHOUSE_MCP_SERVER_TRANSPORT=http
CLICKHOUSE_MCP_BIND_HOST=0.0.0.0
CLICKHOUSE_MCP_BIND_PORT=8000
# Required for HTTP: generate with `openssl rand -hex 32`
CLICKHOUSE_MCP_AUTH_TOKEN=change-me
# Host header values clients use to reach this server
CLICKHOUSE_MCP_ALLOWED_HOSTS=localhost:8000,127.0.0.1:8000

# Tech-support guard: query limits and credential redaction
MCP_MIDDLEWARE_MODULE=mcp_clickhouse.support_guard.middleware
SUPPORT_GUARD_MAX_WINDOW_MINUTES=60
SUPPORT_GUARD_MAX_LIMIT=200
